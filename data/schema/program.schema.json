{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://college-am.dev/schema/program.schema.json",
  "title": "College-AM Program File",
  "description": "一个数据文件 = 一门考试/一个赛事/一个招聘渠道的全部届次（Edition）。",
  "type": "object",
  "required": [
    "schemaVersion",
    "programs"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "programs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/program"
      }
    }
  },
  "$defs": {
    "program": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "aliases",
        "organizer",
        "organizerType",
        "level",
        "tags",
        "majors",
        "officialUrl",
        "summary",
        "editions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "全局唯一，kebab-case"
        },
        "kind": {
          "enum": [
            "cert",
            "contest",
            "job"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "shortName": {
          "type": "string",
          "maxLength": 40
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30
          },
          "maxItems": 12
        },
        "organizer": {
          "type": "string",
          "maxLength": 60
        },
        "organizerType": {
          "enum": [
            "official",
            "academic",
            "company",
            "school"
          ]
        },
        "level": {
          "enum": [
            "international",
            "national",
            "provincial",
            "school"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "majors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "weight"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "weight": {
                "enum": [
                  "core",
                  "recommended",
                  "adjacent"
                ]
              }
            }
          }
        },
        "officialUrl": {
          "type": "string",
          "format": "uri"
        },
        "summary": {
          "type": "string",
          "minLength": 8,
          "maxLength": 120,
          "description": "自写摘要，禁止全文转载官方公告，≤120 字"
        },
        "editions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edition"
          }
        }
      }
    },
    "edition": {
      "type": "object",
      "required": [
        "id",
        "year",
        "round",
        "sourceUrl",
        "fetchedAt",
        "trustTier",
        "reviewState"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "year": {
          "type": "integer",
          "minimum": 2000,
          "maximum": 2100
        },
        "round": {
          "enum": [
            "h1",
            "h2",
            "annual",
            "special"
          ]
        },
        "signupStart": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "signupEnd": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "eventStart": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "eventEnd": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "feeCny": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 5000
        },
        "feeNote": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 80
        },
        "noticeUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "description": "L1 官方原始页面"
        },
        "fetchedAt": {
          "type": "string",
          "format": "date-time"
        },
        "verifiedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "trustTier": {
          "enum": [
            "L1",
            "L2",
            "L3",
            "L4"
          ]
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "reviewState": {
          "enum": [
            "pending",
            "auto_published",
            "human_approved",
            "rejected"
          ]
        },
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 160
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 6
        }
      }
    }
  }
}
